diff --git a/webrtc.gni b/webrtc.gni
index dce017b..caa8ce7 100644
--- a/webrtc.gni
+++ b/webrtc.gni
@@ -255,6 +255,12 @@ declare_args() {
 
   # When true, include the Perfetto library.
   rtc_use_perfetto = false
+
+  # When false, the Android SDK is built without WebRTC's software video
+  # codecs (libvpx VP8/VP9, libaom AV1 encoder, dav1d AV1 decoder).
+  # SoftwareVideoEncoderFactory/SoftwareVideoDecoderFactory then report no
+  # codecs, so video relies on MediaCodec (HardwareVideo*Factory).
+  rtc_include_software_video_codecs = true
 }
 
